DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-0123456789
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://v0:v0@db:5432/v0
# File storage: local disk by default. Set USE_S3=true in production.
USE_S3=false
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# DOCUMENT_MAX_UPLOAD_BYTES=10485760
# Embeddings (required by the worker). Create a key with a monthly spend limit.
OPENAI_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# Embeddings: "local" (no account needed) or "openai".
EMBEDDING_PROVIDER=local
# The local model reads short texts best: use smaller chunks.
INGEST_CHUNK_SIZE=500
INGEST_CHUNK_OVERLAP=80